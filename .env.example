# Copy this file to .env.local. Never commit the real values.
ENABLE_LIVE_SYNC=false

OPENALEX_API_KEY=replace_with_openalex_key
SEMANTIC_SCHOLAR_API_KEY=replace_with_semantic_scholar_key
HF_TOKEN=replace_with_huggingface_read_token

ARXIV_QUERY=cat:cs.AI OR cat:cs.CL OR cat:cs.LG OR cat:cs.CV OR cat:cs.RO
MAX_PAPERS_PER_SOURCE=25
